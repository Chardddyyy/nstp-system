# ==============================================================================
# CvSU Naic NSTP System - Backend Environment Configuration Template
# Copy this file to .env and fill in real values. NEVER commit .env to git!
# ==============================================================================

# Security: JWT Token Signing Secret (Required in production)
# Generate via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_64_CHAR_RANDOM_SECRET

# Server Port
PORT=3001
NODE_ENV=development

# Database Configuration (Option A: Separate variables)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
DB_NAME=nstp_system
DB_SSL=false

# Database Configuration (Option B: Aiven / Cloud MySQL URI - overrides Option A if set)
# DATABASE_URL=mysql://avnadmin:password@mysql-nstp-instance.aivencloud.com:3306/defaultdb?ssl-mode=REQUIRED
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# CORS Allowed Origins (Comma-separated, no trailing slashes)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://chardddyyy.github.io

# Cloudinary Storage (For Student Photos and COR Document Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMS Notification Gateway (Semaphore API - for Digital ID Links)
SEMAPHORE_API_KEY=your_semaphore_api_key
SEMAPHORE_SENDER_NAME=CvSU-NSTP

# Email OTP & Notifications (Gmail / SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Automated Disaster Recovery & Google Drive Webhook
GDRIVE_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id/exec

